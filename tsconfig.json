{
	"compilerOptions": {
		"target": "ES2020",
		"module": "CommonJS",
		"lib": ["ESNext", "DOM"],
		"allowJs": true,
		"checkJs": false,
		"declaration": false,
		"outDir": "./dist",
		"rootDir": "./",
		"strict": true,
		"esModuleInterop": true,
		"moduleResolution": "node",
		"ignoreDeprecations": "6.0",
		"resolveJsonModule": true,
		"skipLibCheck": true
	},
	"include": [
		"main.js"
	],
	"exclude": [
		"node_modules"
	]
}